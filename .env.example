# ── Required ────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Paystack secret key. The SAME key signs webhooks (x-paystack-signature).
PAYSTACK_SECRET_KEY="sk_test_..."

# ── Strongly recommended ────────────────────────────────────
# Public https URL of the deployed app. Used for Paystack callback URLs (do not rely on the Host header).
NEXT_PUBLIC_APP_URL="https://your-app.example.com"
# Protects /api/cron/maintenance (min 16 chars). Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET="generate-a-long-random-string"

# Comma-separated Clerk user ids of platform admins (approve refunds, view reconciliation). Empty = nobody.
ADMIN_USER_IDS=""

# ── Optional ────────────────────────────────────────────────
# AI Assistant (Free Gemini or OpenAI). Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=""
# Or OpenAI key (paid):
OPENAI_API_KEY="sk-..."
# Default false: stores without payout details cannot take payments (otherwise funds land in YOUR Paystack balance with no payout path).
ALLOW_CHECKOUT_WITHOUT_PAYOUT="false"
# DB_PO
